{
  "env": {
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1",
    "GATEGUARD_EXEMPT_GLOBS": "/tmp/**"
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/build-jsx.js)",
      "Bash(node scripts/test-pricing.mjs)",
      "Bash(node scripts/price-consistency.mjs)",
      "Bash(node scripts/smoke-test.cjs)",
      "Bash(node scripts/contrast-audit.cjs)",
      "Bash(python3 scripts/build-lqip.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "mcp__higgsfield",
      "mcp__Publora",
      "mcp__Claude_Code_Remote",
      "mcp__github",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(sleep:*)",
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Agent",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push origin --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-edit-secrets.mjs\"",
            "statusMessage": "Comprobando secretos…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-edit.mjs\"",
            "statusMessage": "Compilando y revisando…",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
